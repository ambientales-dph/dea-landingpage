
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Actividades generales
    match /app_activities/{activityId} {
      allow read, write: if request.auth != null;
    }
    
    match /proyectistas/{proyectistaId} {
      allow read, write: if request.auth != null;
    }
    
    // Rutas de la Línea de Tiempo Migrada (Nombres finales)
    match /timeline-projects/{projectId} {
      allow read, write: if request.auth != null;
      
      match /milestones/{milestoneId} {
        allow read, write: if request.auth != null;
      }
    }
    
    match /timeline-categories/{categoryId} {
      allow read, write: if request.auth != null;
    }
  }
}
