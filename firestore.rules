rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLAS PÚBLICAS PARA EL RADAR (Webhooks y Sincronización)
    // Permitimos acceso total a estas dos colecciones para que el servidor opere sin trabas
    match /mail_alerts/{alertId} {
      allow read, write: if true;
    }

    match /notificaciones_obras/{notificationId} {
      allow read, write: if true;
    }

    // Actividades generales (Requieren login)
    match /app_activities/{activityId} {
      allow read, write: if request.auth != null;
    }
    
    match /proyectistas/{proyectistaId} {
      allow read, write: if request.auth != null;
    }
    
    // Rutas de la Línea de Tiempo y Proyectos
    match /timeline_projects/{projectId} {
      allow read, write: if request.auth != null;
      
      match /milestones/{milestoneId} {
        allow read, write: if request.auth != null;
      }
    }

    match /projects/{projectId} {
      allow read, write: if request.auth != null;
      
      match /milestones/{milestoneId} {
        allow read, write: if request.auth != null;
      }
    }
    
    match /timeline_categories/{categoryId} {
      allow read, write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read, write: if request.auth != null;
    }
  }
}