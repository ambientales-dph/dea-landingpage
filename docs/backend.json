
{
  "entities": {
    "AppActivity": {
      "title": "AppActivity",
      "description": "Registro de acciones realizadas por los usuarios dentro del portal.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhoto": { "type": "string" },
        "actionType": { "type": "string", "enum": ["create_project", "update_project", "delete_project", "status_change", "attach_resource", "remove_attachment", "export_card", "update_cover", "update_labels", "add_comment"] },
        "projectName": { "type": "string" },
        "detail": { "type": "string" },
        "cardId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userEmail", "actionType", "projectName", "timestamp"]
    },
    "Proyectista": {
      "title": "Proyectista",
      "description": "Profesional externo o interno encargado del diseño de proyectos.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "observations": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "TimelineProject": {
      "title": "TimelineProject",
      "description": "Datos extendidos de proyectos para la línea de tiempo.",
      "type": "object",
      "properties": {
        "trelloCardId": { "type": "string" },
        "name": { "type": "string" },
        "driveFolderId": { "type": "string" },
        "customCategories": { "type": "array", "items": { "type": "string" } },
        "lastSync": { "type": "string", "format": "date-time" }
      }
    },
    "Milestone": {
      "title": "Milestone",
      "description": "Hito o evento histórico de un proyecto.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["manual", "automatic", "trello", "drive"] },
        "attachments": { "type": "array", "items": { "type": "object" } },
        "metadata": { "type": "object" }
      },
      "required": ["projectId", "title", "date", "type"]
    },
    "TimelineCategory": {
      "title": "TimelineCategory",
      "description": "Categorías personalizadas para clasificar hitos.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/app_activities/{activityId}": {
      "schema": { "$ref": "#/entities/AppActivity" },
      "description": "Colección global de actividades realizadas en la aplicación."
    },
    "/proyectistas/{proyectistaId}": {
      "schema": { "$ref": "#/entities/Proyectista" },
      "description": "Colección de profesionales proyectistas."
    },
    "/timeline_projects/{projectId}": {
      "schema": { "$ref": "#/entities/TimelineProject" },
      "description": "Configuración extendida de proyectos en la TL."
    },
    "/timeline_projects/{projectId}/milestones/{milestoneId}": {
      "schema": { "$ref": "#/entities/Milestone" },
      "description": "Hitos específicos de un proyecto."
    },
    "/timeline_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/TimelineCategory" },
      "description": "Diccionario de categorías de hitos."
    }
  }
}
