
{
  "entities": {
    "AppActivity": {
      "title": "AppActivity",
      "description": "Registro de acciones realizadas por los usuarios dentro del portal.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhoto": { "type": "string" },
        "actionType": { "type": "string", "enum": ["create_project", "update_project", "delete_project", "status_change", "attach_resource", "remove_attachment", "export_card", "update_cover", "update_labels", "add_comment"] },
        "projectName": { "type": "string" },
        "detail": { "type": "string" },
        "cardId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userEmail", "actionType", "projectName", "timestamp"]
    },
    "Proyectista": {
      "title": "Proyectista",
      "description": "Profesional externo o interno encargado del diseño de proyectos.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "observations": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "TimelineProject": {
      "title": "TimelineProject",
      "description": "Datos de proyectos migrados de la Línea de Tiempo.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "Milestone": {
      "title": "Milestone",
      "description": "Hito o evento histórico de un proyecto de la TL.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "category": { "type": "object" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "associatedFiles": { "type": "array", "items": { "type": "object" } },
        "isImportant": { "type": "boolean" },
        "history": { "type": "array", "items": { "type": "string" } }
      }
    },
    "TimelineCategory": {
      "title": "TimelineCategory",
      "description": "Categorías de hitos de la TL.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "color": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/app_activities/{activityId}": {
      "schema": { "$ref": "#/entities/AppActivity" },
      "description": "Actividades del portal."
    },
    "/proyectistas/{proyectistaId}": {
      "schema": { "$ref": "#/entities/Proyectista" },
      "description": "Directorio de proyectistas."
    },
    "/timeline-projects/{projectId}": {
      "schema": { "$ref": "#/entities/TimelineProject" },
      "description": "Proyectos de la Línea de Tiempo."
    },
    "/timeline-projects/{projectId}/milestones/{milestoneId}": {
      "schema": { "$ref": "#/entities/Milestone" },
      "description": "Hitos de la TL."
    },
    "/timeline-categories/{categoryId}": {
      "schema": { "$ref": "#/entities/TimelineCategory" },
      "description": "Categorías de la TL."
    }
  }
}
